{
  "$schema": "https://turborepo.dev/schema.json",
  "globalPassThroughEnv": ["DATABASE_URL"],
  "tasks": {
    "build": {
      "cache": false,
      "outputLogs": "new-only",
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "build:tauri": {
      "cache": false
    },
    "check-types": {
      "cache": false,
      "inputs": ["$TURBO_DEFAULT$", "tsconfig*.json"],
      "outputLogs": "new-only"
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:tauri": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}
