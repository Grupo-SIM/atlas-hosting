{
  "name": "@repo/site-builder",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js"
    },
    "./editor": {
      "types": "./out/editor/index.d.ts",
      "import": "./out/editor/index.js"
    },
    "./fx": {
      "types": "./out/renderer/FxRuntime.d.ts",
      "import": "./out/renderer/FxRuntime.js"
    },
    "./static": {
      "types": "./out/static/index.d.ts",
      "import": "./out/static/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@hyoretsu/configs": "^1.2.35",
    "@types/react": "^19.1.6",
    "react": "^19.2.5",
    "typescript": "^5",
    "react-dom": "^19.2.5",
    "@types/react-dom": "19.1.5"
  }
}
