{
  "name": "atlas-hosting",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "commit": "git add . && bun committier ai",
    "dev": "turbo dev",
    "domain:reprocess": "bun scripts/reprocess-domain-invoice.ts",
    "format": "bun format:biome .",
    "format:biome": "bunx biome check --diagnostic-level=error --write",
    "prepare": "lefthook install || true",
    "start": "turbo start",
    "tauri:dev": "turbo dev:tauri",
    "tauri:build": "turbo build:tauri"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@hyoretsu/configs": "^1.2.35",
    "committier": "^0.2.3",
    "lefthook": "^2.1.9",
    "lint-staged": "^16.4.0",
    "turbo": "^2.9.16"
  }
}
