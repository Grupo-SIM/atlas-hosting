import { type User, pgOrganization } from "@/lib/db/schema";
import { EventEmitter } from "node:stream";
import pleskApi from "@/lib/server/apis/plesk";
import { ClientRequestTypeEnum } from "@/plesk";
import { db } from "@/lib/db";
import { eq } from "drizzle-orm";

export const eventEmitter = new EventEmitter();

export const events = {
  INSTALL_STARTED: "installStarted",
  INSTALL_COMPLETED: "installCompleted",
  INSTALL_FAILED: "installFailed",
  CERTIFICATE_INSTALL_STARTED: "certificateInstallStarted",
  CERTIFICATE_INSTALL_COMPLETED: "certificateInstallCompleted",
  CERTIFICATE_INSTALL_FAILED: "certificateInstallFailed",
};

export interface InstallRequestEvent {
  domainName: string;
  adminUsername: string;
  adminPassword: string;
  siteName: string;
  adminEmail: string;
  plugins: string[];
}

eventEmitter.on("install-wp", (event) => {});

export class EventHandler {
  public generateTask() {
    const taskId = crypto.randomUUID();
    return taskId;
  }
}

export interface TaskResult {
  ok: boolean;
}

export abstract class Task<T> {
  constructor(
    protected readonly id: string,
    protected param: T
  ) {}

  public abstract work(): Promise<TaskResult>;
}

export interface InstallWordpressParams {
  domainName: string;
  adminUsername: string;
  adminPassword: string;
  siteName: string;
  adminEmail: string;
  plugins: string[];
}

export interface InstallWordpressTaskParam extends InstallWordpressParams {
  user: User;
}

export class InstallWordpressTask extends Task<InstallWordpressTaskParam> {}

export class CreatePleskUserTask extends Task<User> {
  public async work() {
    try {
      const user = this.param;

      if (!user) {
        return { ok: false };
      }

      let { pleskId } = user.organization;
      const { email: userEmailForPlesk } = user;

      if (!pleskId) {
        const pleskClientPassword = "Default#Password123";

        const result = await pleskApi.createClient({
          name: user.name,
          email: userEmailForPlesk,
          login: user.id.replaceAll("-", "").substring(0, 50),
          password: pleskClientPassword,
          type: ClientRequestTypeEnum.Customer,
          status: 0,
        });

        pleskId = result.id;
      }

      if (pleskId) {
        await this.setUserPleskId(pleskId);
        return { ok: true };
      }

      return { ok: false };
    } catch {
      return { ok: false };
    }
  }

  private async setUserPleskId(pleskId: string) {
    await db
      .update(pgOrganization)
      .set({ pleskId })
      .where(eq(pgOrganization.id, this.param.organization.id));
  }
}

export class CreatePleskSubscriptionTask extends Task<InstallWordpressTaskParam> {
  public async work() {
    try {
      const existingDomainInPlesk = await pleskApi
        .getDomain(this.param.domainName)
        .catch(() => null);

      if (existingDomainInPlesk) {
        await pleskApi.deleteDomain(existingDomainInPlesk.id);
      }

      await pleskApi.subscriptions.createSubscription({
        domainName: this.param.domainName,
        login: `${this.param.domainName.replace(/\./g, "_")}_${this.param.user.id}`,
        password: `${this.param.adminPassword}_${this.param.user.id}`, // Consider a more robust password generation strategy
        ownerLogin: this.param.user.id.replaceAll("-", "").substring(0, 50),
      });

      await pleskApi.assignDomain(this.param.domainName, +this.param.user.id);

      return { ok: true };
    } catch {
      return { ok: false };
    }
  }
}
