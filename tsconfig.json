{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "files": [
    "global.d.ts"
  ],
  "include": [
    "global.d.ts",
    "next-env.d.ts",
    "next.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "src/app/(auth)/email/components/EmailHeader.tsxold",
    "src/app/(auth)/email/components/EmailSidebar.tsxold",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules/**/*",
    "src/plesk/**/*",
    "**/*.tsxold"
  ]
}
